# ============================================================
# 开发环境配置（npm run dev / npm run build -- --mode development）
#
# 变量命名约定：
#   VITE_ 开头 -> 会注入到前端代码里（浏览器能拿到）
#   DEV_ 开头  -> 只给 vite.config.ts 用，不进前端产物
#
# 改后端端口只需要动 DEV_PROXY_TARGET 这一行，其它文件都不用碰。
# ============================================================

# 前端 dev server 端口。
# 被占用时 Vite 会自动 +1（5173 -> 5174）；想让它直接报错而不是悄悄换端口，
# 在 vite.config.ts 的 server 里加 strictPort: true。
DEV_SERVER_PORT=5173

# 本地后端（studydemo-backend）的地址 —— 要和后端 application.yaml 里的 server.port 保持一致。
# 这里必须写 127.0.0.1，不要写 localhost：
# Node 解析 localhost 会优先拿到 IPv6 的 ::1，而 Spring Boot 默认只监听 IPv4，
# 结果就是后端明明启动了，代理却报 502 ECONNREFUSED。
DEV_PROXY_TARGET=http://127.0.0.1:8080

# 前端代码请求接口时用的前缀（见 src/api/http.ts）。
# 开发环境保持 /api，由 Vite 代理转发到 DEV_PROXY_TARGET，
# 浏览器眼里始终是同源请求，所以不会触发跨域。
VITE_API_BASE=/api
